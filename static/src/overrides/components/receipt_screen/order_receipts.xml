<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    
    <t t-name="OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]/div[hasclass('pos-receipt-order-data')]" position="before">
            <div class="pos-receipt-order-data">
                <div t-if="currentOrder.to_invoice">
                    <div class="info_certificador">
                        <div>Certificador</div>
                        <div>INFILE, S.A.</div>
                        <div>NIT: 12521337</div>
                    </div>
                </div>    
            </div>
        </xpath>    
    </t>
</templates>